+uint64
+sys_kmap(void)
+{
+  struct proc* p = myproc();
+  if (p->shm != 0) return -1;  // already initialized
+
+  char* mem = kalloc();
+  if (mem == 0) return -1;
+
+  memset(mem, 0, PGSIZE);
+
+  uint64 uaddr = PGROUNDUP(p->sz);
+  // calling heap after this might lead to holes in
+
+  if (mappages(p->pagetable, uaddr, PGSIZE, (uint64)mem,
+               PTE_R | PTE_W | PTE_U) < 0) {
+      kfree(mem);
+      return -1;
+  }
+
+  p->sz = uaddr + PGSIZE;
+  p->shm = (struct shm_channel*)mem;
+
+  return uaddr;
+}
