diff --git a/kernel/sysfile.c b/kernel/sysfile.c
index d8234ce..9bd5d05 100644
--- a/kernel/sysfile.c
+++ b/kernel/sysfile.c
@@ -503,3 +503,49 @@ sys_pipe(void)
   }
   return 0;
 }
+
+uint64
+sys_spawn(void)
+{
+  char path[MAXPATH], *argv[MAXARG];
+  int i;
+  uint64 uargv, uarg;
+
+  argaddr(1, &uargv);
+  if (uargv == 0) {
+    return kfork();
+  }
+  if(argstr(0, path, MAXPATH) < 0) {
+    return -1;
+  }
+  memset(argv, 0, sizeof(argv));
+  for(i=0;; i++){
+    if(i >= NELEM(argv)){
+      goto bad;
+    }
+    if(fetchaddr(uargv+sizeof(uint64)*i, (uint64*)&uarg) < 0){
+      goto bad;
+    }
+    if(uarg == 0){
+      argv[i] = 0;
+      break;
+    }
+    argv[i] = kalloc();
+    if(argv[i] == 0)
+      goto bad;
+    if(fetchstr(uarg, argv[i], PGSIZE) < 0)
+      goto bad;
+  }
+
+  int ret = kspawn(path, argv);
+
+  for(i = 0; i < NELEM(argv) && argv[i] != 0; i++)
+    kfree(argv[i]);
+
+  return ret;
+
+ bad:
+  for(i = 0; i < NELEM(argv) && argv[i] != 0; i++)
+    kfree(argv[i]);
+  return -1;
+}
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 419e727..f809a67 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -7,6 +7,8 @@
 #include "proc.h"
 #include "vm.h"
 
+extern uint sbrklazy_size;
+
 uint64
 sys_exit(void)
 {
@@ -107,3 +109,41 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_get_pagefaults(void)
+{
+  return myproc()->pagefaults;
+}
+
+uint64
+sys_va2pa(void) {
+  uint64 va;
+  struct proc *p = myproc();
+  pte_t *pte;
+  uint64 pa;
+  argaddr(0, &va);
+  pte = walk(p->pagetable, va, 0);
+  if(pte == 0)
+    return 0;
+
+  if((*pte & PTE_V) == 0)
+    return 0;
+
+  // Extract physical address from PTE
+  pa = PTE2PA(*pte);
+
+  // Add page offset
+  return pa + (va % PGSIZE);
+}
+
+uint64
+sys_sbrklazy_size(void)
+{
+    int size = 0;
+    argint(0, &size);
+    if(size <= 0)
+        return -1;
+    sbrklazy_size = size;
+    return 0;
+}
