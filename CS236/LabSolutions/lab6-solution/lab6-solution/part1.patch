diff --git a/kernel/proc.c b/kernel/proc.c
index 22a5401..e6ec118 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -305,6 +305,70 @@ kfork(void)
   return pid;
 }
 
+struct proc*
+findproc(int pid)
+{
+  struct proc *p;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED)
+      return p;
+  }
+
+  return 0;
+}
+
+int
+pfork(int parent_pid)
+{
+  int i, pid;
+  struct proc *np;
+  struct proc *parent;
+  struct proc *cur = myproc();
+
+  //finding the pcb for the parent
+  parent = findproc(parent_pid);
+  if(parent == 0)
+    return -1;
+
+  // Allocate process.
+  if((np = allocproc()) == 0)
+    return -1;
+
+  if(uvmcopy(cur->pagetable, np->pagetable, cur->sz) < 0){
+    freeproc(np);
+    release(&np->lock);
+    return -1;
+  }
+  np->sz = cur->sz;
+
+  *(np->trapframe) = *(cur->trapframe);
+  np->trapframe->a0 = 0;
+
+  // increment reference counts on open file descriptors.
+  for(i = 0; i < NOFILE; i++)
+    if(cur->ofile[i])
+      np->ofile[i] = filedup(cur->ofile[i]);
+  np->cwd = idup(cur->cwd);
+
+  safestrcpy(np->name, cur->name, sizeof(cur->name));
+
+  pid = np->pid;
+
+  release(&np->lock);
+
+  acquire(&wait_lock);
+  //parent change
+  np->parent = parent; 
+  release(&wait_lock);
+
+  acquire(&np->lock);
+  np->state = RUNNABLE;
+  release(&np->lock);
+
+  return pid;
+}
+
 // Pass p's abandoned children to init.
 // Caller must hold wait_lock.
 void
