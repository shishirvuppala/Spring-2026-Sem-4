diff --git a/user/p1a.c b/user/p1a.c
new file mode 100644
index 0000000..92a9bfb
--- /dev/null
+++ b/user/p1a.c
@@ -0,0 +1,33 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+#define NUMPAGES 512
+#define PAGESIZE 4096
+
+int main(int argc, char* argv[]) {
+  if (argc != 2) {
+    printf("Usage: p1a <sbrklazy_size>\n");
+    exit(1);
+  }
+
+  int k = atoi(argv[1]);
+  if (k <= 0 || k > NUMPAGES) {
+    printf("0 <= sbrklazy_size <= %d\n", NUMPAGES);
+    exit(1);
+  }
+
+  sbrklazy_size(k); // Uncomment this line after implementing sbrklazy_size
+
+  char* old_sbrk = (char*)sbrklazy(NUMPAGES * PAGESIZE);
+  printf("Number of pages allocated: %d, k = %d\n", NUMPAGES, k);
+
+  for (char* p = old_sbrk; p < old_sbrk + NUMPAGES * PAGESIZE; p += PAGESIZE) {
+    *p = 'a';
+  }
+
+  printf("Expected page faults: %d\n", (NUMPAGES + k - 1) / k);
+  printf("Actual page faults: %d\n", get_pagefaults());
+
+  exit(0);
+}
\ No newline at end of file
diff --git a/user/p1b.c b/user/p1b.c
new file mode 100644
index 0000000..4701deb
--- /dev/null
+++ b/user/p1b.c
@@ -0,0 +1,47 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+#define NUMPAGES 12
+#define PAGESIZE 4096
+
+void access_page(char* base, int pg) {
+  printf("Accessing page %d | ", pg);
+  base[pg * PAGESIZE] = 'x';
+  printf("total pgfaults: %d\n", get_pagefaults());
+}
+
+int main(int argc, char* argv[]) {
+  sbrklazy_size(4); // Uncomment this line after implementing sbrklazy_size
+
+  char* base = (char*)sbrklazy(NUMPAGES * PAGESIZE);
+
+  printf("sbrklazy_size = 4\n");
+  printf("Allocated %d pages lazily\n\n", NUMPAGES);
+
+  access_page(base, 2);  // expect faults = 1
+  access_page(base, 3);  // should not fault
+  access_page(base, 5);  // should not fault
+  access_page(base, 4);  // should not fault
+
+  printf("\n");
+  
+  access_page(base, 7); // expect faults = 2
+  access_page(base, 8); // should not fault
+  access_page(base, 9); // should not fault
+  access_page(base, 10); // should not fault
+
+  printf("\n");
+
+  access_page(base, 0); // expect faults = 3
+  access_page(base, 1); // should not fault
+  access_page(base, 6); // should not fault
+  access_page(base, 11); // should not fault
+
+  printf("\n");
+  access_page(base, 5); // should not fault
+
+  access_page(base, 12); // trap!!!
+
+  exit(0);
+}
