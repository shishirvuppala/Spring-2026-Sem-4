+
+void sys_knockknock(void) {
+  printf("[pid %d] Who's there?\n", myproc()->pid);
+}
+
+void sys_getProcessStates(void) {
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++){
+    if(p->state == UNUSED)
+      continue;
+    char *state;
+    switch(p->state) {
+      case SLEEPING: state = "SLEEPING"; break;
+      case RUNNABLE: state = "RUNNABLE"; break;
+      case RUNNING:  state = "RUNNING";  break;
+      case ZOMBIE:   state = "ZOMBIE";   break;
+      default:      state = "UNKNOWN";  break;
+    }
+    printf("Process %d was found in %s state\n", p->pid, state);
+  }
+}
+
+
+void sys_areYouThere() {
+  int pid;
+  argint(0, &pid);
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    if(p->pid == pid) {
+      char *state;
+      switch(p->state) {
+        case SLEEPING: state = "SLEEPING"; break;
+        case RUNNABLE: state = "RUNNABLE"; break;
+        case RUNNING:  state = "RUNNING";  break;
+        case ZOMBIE:   state = "ZOMBIE";   break;
+        default:      state = "UNKNOWN";  break;
+      }
+      printf("%d has been found in %s state\n", pid, state);
+      return;
+    }
+  }
+  printf("%d has gone missing\n", pid);
+}
+
+int sys_getChildCount() {
+  return myproc()->child_count;
+}
