+
+  for (; p < old_sbrk + 4 * NUMPAGES * PAGESIZE / 4; p += PAGESIZE) {
+    *p = 'b';
+  }
+
+  printf("Expected page faults: %d\n",
+         NUMPAGES / 4 + NUMPAGES / 4 / 2 + NUMPAGES / 4 / 4 + NUMPAGES / 4);
+  printf("Actual page faults: %d\n", get_pagefaults());
+
+  exit(0);
+}
