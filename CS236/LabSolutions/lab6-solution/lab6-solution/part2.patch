diff --git a/kernel/shm.c b/kernel/shm.c
new file mode 100644
index 0000000..736ef3e
--- /dev/null
+++ b/kernel/shm.c
@@ -0,0 +1,179 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "proc.h"
+#include "defs.h"
+#include "shm.h"
+
+
+uint64 sys_shm_init(void)
+{
+    struct proc *p = myproc();
+
+    // TODO: Check whether a shared memory page is already created.
+    // If shm.valid indicates an existing shared page, this syscall
+    // must fail because we only allow ONE shared page in this lab.
+    // Return -1 in that case.
+    if(shm.valid)
+        return -1;
+
+    // TODO: Allocate exactly one physical page from the kernel
+    // allocator using kalloc(). This will return a kernel virtual
+    // address (KVA). If allocation fails (returns 0), return -1.
+    char *mem = kalloc();
+    if(mem==0)
+        return -1;
+
+    // TODO: Initialize (zero out) the allocated page using memset()
+    // so that the shared memory starts in a clean state.
+    memset(mem, 0, PGSIZE);
+
+    // TODO: Initialize the global shared memory structure:
+    // shm.kva    → store the allocated kernel virtual address
+    // shm.refcnt → set to 0 because no process has attached yet
+    // shm.valid  → mark as 1 (or true) to indicate the page exists
+
+    shm.kva = (uint64)mem; // address returned by kalloc(), typecast to uint64 if required
+    shm.refcnt = 0;
+    shm.valid = 1;
+
+    // TODO: Initialize the current process attachment state.
+    // Since the process has not attached yet, mark it as not attached.
+    // Suggested convention: -1 means "not attached".
+    p->shm_attached = -1;
+
+    // Success
+    return 0;
+
+}
+
+uint64 sys_shm_attach(void)
+{
+    struct proc *p = myproc();
+
+    // TODO: First verify that the shared memory page has been created.
+    // If shm.valid is false (or 0), it means shm_init() was never called.
+    // In that case, attaching should fail and return -1.
+    if(!shm.valid)
+        return -1;
+
+    // TODO: Also check if this process has already attached.
+    // If p->shm_attached=1 indicates an existing attachment,
+    // do NOT attach again (avoid double mapping) and return -1.
+    if(p->shm_attached==1)
+        return -1;
+
+    // We will map the shared memory at a fixed virtual address
+    // so that all processes see it at the same location.
+    uint64 uva = SHMEM;
+
+    // TODO: Set pa (physical address) to the physical page that
+    // backs the shared memory. This should come from shm.kva
+    // (the page allocated during shm_init).
+
+    uint64 pa = shm.kva;
+
+    // TODO: Map the shared physical page into this process’s
+    // page table using mappages().
+    // Permissions should allow user read and write access.
+    // If mapping fails, return -1.
+    if (mappages(p->pagetable, uva, PGSIZE, pa,
+                 PTE_R | PTE_W | PTE_U) < 0)
+    {
+        return -1;
+    }
+
+    // TODO: Increase the global reference count because one more
+    // process is now using (referencing) the shared memory page.
+    shm.refcnt++;
+
+    // TODO: Mark that this process has successfully attached
+    // to the shared memory to prevent duplicate attachments.
+    p->shm_attached = 1;
+
+    // Return the user virtual address where the page is mapped
+    return uva;
+}
+
+uint64 sys_shm_detach(void)
+{
+    struct proc *p = myproc();
+
+    // TODO: Validate two conditions before detaching:
+    // 1) Shared memory must exist (shm.valid should be true)
+    // 2) This process must currently be attached (p->shm_attached == 1)
+    // If either condition fails, return -1.
+    if(!shm.valid || p->shm_attached!=1)
+        return -1;
+
+    // TODO: Unmap the shared memory page from the process’s
+    // virtual address space using uvmunmap().
+    // IMPORTANT: Do NOT free the physical page here,
+    // because other processes might still be using it.
+    uvmunmap(p->pagetable, SHMEM, 1, 0); // 1 page, do not free physical memory
+
+    // TODO: Decrease the global reference count since this
+    // process is no longer referencing the shared memory.
+    shm.refcnt--;
+
+    // TODO: Update the process state to indicate that it is
+    // no longer attached to the shared memory.
+    p->shm_attached = -1;
+
+    return 0; // success
+}
+
+uint64 sys_shm_destroy(void)
+{
+    struct proc *p = myproc();
+
+    // TODO: First check if the shared memory page even exists.
+    // If shm.valid is false, destruction should fail (return -1).
+    if(!shm.valid)
+        return -1;
+
+    // TODO: Ensure that no process is currently using the shared memory.
+    // If shm.refcnt is NOT zero, it means some process is still attached.
+    // In that case, do NOT destroy the page and return -1.
+    if(shm.refcnt!=0)
+        return -1;
+
+    // TODO:
+    // Check that the calling process has properly
+    // detached before destroying (i.e., p->shm_attached == -1).
+    if(p->shm_attached!=-1)
+        return -1;
+
+    // TODO: Free the physical page using kfree().
+    // This releases the memory back to the kernel allocator.
+    //kfree((char *)va);
+    kfree((char *)shm.kva);
+
+    // TODO: Reset the global shared memory metadata so that the
+    // system returns to the "no shared memory" state:
+    // shm.valid  → 0 (invalid)
+    // shm.kva    → 0 (no page)
+    // shm.refcnt → 0 (no references)
+
+    shm.valid = 0;
+    shm.kva = 0;
+    shm.refcnt = 0;
+
+    // TODO: Reset process state to default (not attached)
+    p->shm_attached = 0;
+
+    // Success
+    return 0;
+}
+
+uint64 sys_shm_refcnt(void)
+{ 
+    // TODO: First check if the shared memory page exists.
+    // If shm.valid is false (return -1).
+    if(!shm.valid)
+        return -1;
+    //TODO: Return reference count
+    return shm.refcnt;
+}
