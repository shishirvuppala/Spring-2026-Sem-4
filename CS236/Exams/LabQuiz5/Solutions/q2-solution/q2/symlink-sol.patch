+    return "T_SYMLINK";
+  default:
+    return "UNKNOWN";
+  }
+}
+
+void
+test_symlink(const char* orig_file, const char* link_file)
+{
+  char buf[128];
+  int fd, n;
+  int type_orig, type_link;
+  int refcount_orig, refcount_link;
+  char linkpath[MAXPATH];
+
+  cleanup(orig_file, link_file);
+
+  printf("\n========== SYMLINK TEST SUITE ==========\n\n");
+
+  printf("[STEP 1] Creating original file '%s'...\n", orig_file);
+
+  fd = open(orig_file, O_CREATE | O_WRONLY | O_TRUNC);
+  if(fd < 0) {
+    fprintf(2, "ERROR: Failed to create %s\n", orig_file);
+    exit(1);
+  }
+
+  if(write(fd, "original content", 16) != 16) {
+    fprintf(2, "ERROR: Failed to write to %s\n", orig_file);
+    exit(1);
+  }
+  close(fd);
+
+  printf("SUCCESS: Created '%s' with content 'original "
+         "content'\n\n",
+         orig_file);
+
+  printf("[STEP 2] Creating symbolic link '%s' -> "
+         "'%s'...\n",
+         link_file, orig_file);
+
+  if(symlink(orig_file, link_file) < 0) {
+    fprintf(2, "ERROR: symlink syscall failed\n");
+    exit(1);
+  }
+
+  printf("SUCCESS: Symlink created\n\n");
+
+  printf("[STEP 3] Verifying file types...\n");
+
+  type_orig = filetype(orig_file);
+  if(type_orig != T_FILE) {
+    fprintf(2, "ERROR: %s has type %s (expected T_FILE)\n", orig_file,
+            filetype_str(type_orig));
+    exit(1);
+  }
+
+  printf("%s type: %s  ✓\n", orig_file, filetype_str(type_orig));
+
+  type_link = filetype(link_file);
+  if(type_link != T_SYMLINK) {
+    fprintf(2, "ERROR: %s has type %s (expected T_SYMLINK)\n", link_file,
+            filetype_str(type_link));
+    exit(1);
+  }
+
+  printf("%s type: %s  ✓\n\n", link_file, filetype_str(type_link));
+
+  printf("[STEP 4] Testing readlink syscall...\n");
+
+  n = readlink(link_file, linkpath, MAXPATH);
+  if(n < 0) {
+    fprintf(2, "ERROR: readlink syscall failed\n");
+    exit(1);
+  }
+
+  linkpath[n] = 0;
+  if(strcmp(linkpath, orig_file) != 0) {
+    fprintf(2, "ERROR: readlink returned '%s' (expected '%s')\n", linkpath,
+            orig_file);
+    exit(1);
+  }
+
+  printf("readlink('%s') = '%s'  ✓\n\n", link_file, linkpath);
+
+  printf("[STEP 5] Checking inode reference counts...\n");
+
+  refcount_orig = inoderefcount(orig_file);
+  if(refcount_orig != 1) {
+    fprintf(2, "ERROR: %s has refcount %d (expected 1)\n", orig_file,
+            refcount_orig);
+    exit(1);
+  }
+
+  printf("%s inode refcount: %d  ✓\n", orig_file, refcount_orig);
+
+  refcount_link = inoderefcount(link_file);
+  if(refcount_link != 1) {
+    fprintf(2, "ERROR: %s has refcount %d (expected 1)\n", link_file,
+            refcount_link);
+    exit(1);
+  }
+
+  printf("%s inode refcount: %d  ✓\n", link_file, refcount_link);
+  printf("(Symlinks have separate inodes, don't increment target "
+         "refcount)\n\n");
+
+  printf("[STEP 6] Testing write redirection through symlink...\n");
+  printf("Writing 'through symlink' to %s...\n", link_file);
+
+  fd = open(link_file, O_WRONLY | O_TRUNC);
+  if(fd < 0) {
+    fprintf(2, "ERROR: Failed to open %s for writing\n", link_file);
+    exit(1);
+  }
+
+  if(write(fd, "through symlink", 15) != 15) {
+    fprintf(2, "ERROR: Write through symlink failed\n");
+    exit(1);
+  }
+  close(fd);
+
+  printf("Reading from %s to verify write went through...\n", orig_file);
+
+  fd = open(orig_file, O_RDONLY);
+  if(fd < 0) {
+    fprintf(2, "ERROR: Failed to open %s for reading\n", orig_file);
+    exit(1);
+  }
+
+  memset(buf, 0, sizeof(buf));
+  n = read(fd, buf, sizeof(buf));
+  if(n < 0) {
+    fprintf(2, "ERROR: Read from %s failed\n", orig_file);
+    exit(1);
+  }
+  close(fd);
+
+  if(strcmp(buf, "through symlink") != 0) {
+    fprintf(2, "ERROR: %s contains '%s' (expected 'through symlink')\n",
+            orig_file, buf);
+    exit(1);
+  }
+
+  printf("Result: %s contains '%s'  ✓\n", orig_file, buf);
+  printf("(Write through symlink correctly redirected to target!)\n\n");
+
+  printf("[STEP 7] Testing read redirection through symlink...\n");
+  printf("Writing 'direct to orig' to %s...\n", orig_file);
+
+  fd = open(orig_file, O_WRONLY | O_TRUNC);
+  if(fd < 0) {
+    fprintf(2, "ERROR: Failed to open %s for writing\n", orig_file);
+    exit(1);
+  }
+
+  if(write(fd, "direct to orig", 14) != 14) {
+    fprintf(2, "ERROR: Write to %s failed\n", orig_file);
+    exit(1);
+  }
+  close(fd);
+
+  printf("Reading from %s to verify read goes through...\n", link_file);
+
+  fd = open(link_file, O_RDONLY);
+  if(fd < 0) {
+    fprintf(2, "ERROR: Failed to open %s for reading\n", link_file);
+    exit(1);
+  }
+
+  memset(buf, 0, sizeof(buf));
+  n = read(fd, buf, sizeof(buf));
+  if(n < 0) {
+    fprintf(2, "ERROR: Read from %s failed\n", link_file);
+    exit(1);
+  }
+  close(fd);
+
+  if(strcmp(buf, "direct to orig") != 0) {
+    fprintf(2, "ERROR: %s contains '%s' (expected 'direct to orig')\n",
+            link_file, buf);
+    exit(1);
+  }
+
+  printf("Result: %s contains '%s'  ✓\n", link_file, buf);
+  printf("(Read through symlink correctly resolved to target!)\n\n");
+
+  printf("========== ALL SYMLINK TESTS PASSED! ==========\n\n");
+
+  cleanup(orig_file, link_file);
+}
+
+int
+main(int argc, char* argv[])
+{
+  const char* orig_file = DEFAULT_ORIG_FILE;
+  const char* link_file = DEFAULT_LINK_FILE;
+
+  if(argc >= 2)
+    orig_file = argv[1];
+  if(argc >= 3)
+    link_file = argv[2];
+
+  test_symlink(orig_file, link_file);
+  exit(0);
+}
