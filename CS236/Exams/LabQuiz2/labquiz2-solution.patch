@@ -0,0 +1,41 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int main(int argc, char* argv[]) {
+  if (argc != 2) {
+    printf("Usage: %s <iterations>\n", argv[0]);
+    exit(1);
+  }
+
+  int iterations = atoi(argv[1]);
+
+  // Uncomment this line after you implement fastuptime
+  printf("start: uptime() = %u\tfastuptime() = %u\n", uptime(), fastuptime());
+
+  uint64 t1, t2, t3, t4;
+
+  // ---- measure normal syscall uptime() ----
+  t1 = uptime();
+  for (int i = 0; i < iterations; i++) {
+    fastuptime(); // Uncomment this line after you implement fastuptime
+  }
+  t2 = uptime();
+
+  uint64 elapsed_fast = t2 - t1;
+  printf("fastuptime() * %d: %lu ticks\n", iterations, elapsed_fast);
+
+  // ---- measure direct fastuptime() ----
+  t3 = uptime();
+  for (int i = 0; i < iterations; i++) {
+    uptime();
+  }
+  t4 = uptime();
+
+  uint64 elapsed_sys = t4 - t3;
+
+  printf("uptime()     * %d: %lu ticks\n", iterations, elapsed_sys);
+
+  // Uncomment this line after you implement fastuptime
+  printf("end  : uptime() = %u\tfastuptime() = %u\n", uptime(), fastuptime());
+  exit(0);
+}
diff --git a/user/p3d.c b/user/p3d.c
new file mode 100644
index 0000000..d1f438b
--- /dev/null
+++ b/user/p3d.c
@@ -0,0 +1,48 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+#define PGSIZE 4096  // bytes per page
+#define MAXVA (1L << (9 + 9 + 9 + 12 - 1))
+#define TRAMPOLINE (MAXVA - PGSIZE)
+#define TRAPFRAME (TRAMPOLINE - PGSIZE)
+#define FASTUPTIME_PAGE (TRAPFRAME - PGSIZE)
+
+int main(int argc, char* argv[]) {
+  if (argc != 2) {
+    printf("Usage: %s <num_processes>\n", argv[0]);
+    exit(1);
+  }
+  int numprocs = atoi(argv[1]);
+
+  printf("[Parent] Creating %d processes...\n", numprocs);
+  
+  // Uncomment this line after you implement fastuptime
+  printf("[Parent] uptime() = %u\tfastuptime() = %u\n", uptime(), fastuptime());
+  for (int p = 0; p < numprocs; p++) {
+    int sleep_dur = 4 * (p + 1);
+    printf("[Parent] Child-%d will sleep for %d ticks\n", p + 1, sleep_dur);
+  }
+  for (int p = 0; p < numprocs; p++) {
+    int pid = fork();
+
+    if (pid < 0) {
+      printf("fork failed\n");
+      exit(1);
+    }
+
+    if (pid == 0) {
+      // Uncomment these after you implement fastuptime
+      int sleep_dur = 4 * (p + 1);
+      pause(sleep_dur);
+      printf("[Child %d] woke up! uptime() = %u\tfastuptime() = %u\n", p + 1, uptime(), fastuptime());
+      exit(0);
+    }
+  }
+
+  for (int i = 0; i < numprocs; i++) {
+    wait(0);
+  }
+
+  exit(0);
+}
