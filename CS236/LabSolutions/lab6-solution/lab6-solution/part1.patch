diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 419e727..840ca5e 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -107,3 +107,68 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_tfork(void)
+{
+  int n;
+  uint64 pids;
+  struct proc* p = myproc();
+
+  argint(0, &n);
+  if (n < 0) return -1;
+
+  argaddr(1, &pids);
+
+  for (int i = 0; i < n; i++) {
+    int pid = kfork();
+    if (pid < 0) return -1;
+    if (pid == 0) return 0;
+
+    // read copyout
+    if (copyout(p->pagetable, pids + i * sizeof(int), (char*)&pid,
+                sizeof(int)) < 0)
+      return -1;
+  }
+
+  return n;
+}
+
+uint64
+sys_tfork2(void)
+{
+  int n;
+  uint64 pids;
+  struct proc* p = myproc();
+
+  argint(0, &n);
+  if (n < 0) return -1;
+
+  argaddr(1, &pids);
+
+  int curr_parent = p->pid;
+  for (int i = 0; i < n; i++) {
+    int pid = pfork(curr_parent);
+    if (pid < 0) return -1;
+    if (pid == 0) return 0;
+
+    // read copyout
+    if (copyout(p->pagetable, pids + i * sizeof(int), (char*)&pid,
+                sizeof(int)) < 0)
+      return -1;
+
+    // setting new child's pid for next parent
+    curr_parent = pid;
+  }
+
+  return n;
+}
+
+uint64
+sys_getppid(void)
+{
+  struct proc* p = myproc();
+  if (p->parent) return p->parent->pid;
+
+  return -1;
+}
diff --git a/user/p1a.c b/user/p1a.c
new file mode 100644
index 0000000..bff5ae8
--- /dev/null
+++ b/user/p1a.c
@@ -0,0 +1,32 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char* argv[])
+{
+    int N = 4, i;
+    if (argc > 1) N = atoi(argv[1]);
+
+    int pids[N];
+    int parent_id = getpid();
+
+    int ret = tfork(N, pids);
+    if (ret == 0) {  // CHILD
+        int child_id = getpid();
+        pause(child_id % 10);
+
+        printf("child: pid=%d ppid=%d\n", child_id, parent_id);
+
+        exit(0);
+    }
+
+    // ORIGINAL PARENT
+    for (i = 0; i < N; i++) wait(0);
+
+    printf("parent: pid=%d\n", parent_id);
+
+    printf("Parent Process Summary:\n");
+    for (i = 0; i < N; i++) printf("  level %d -> pid %d\n", 1, pids[i]);
+
+    exit(0);
+}
