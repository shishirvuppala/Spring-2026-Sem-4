+uint64
+sys_symlink(void)
+{
+  char target[MAXPATH], path[MAXPATH];
+
+  if(argstr(0, target, MAXPATH) < 0 || argstr(1, path, MAXPATH) < 0)
+    return -1;
+
+  // TODO
+
+  return -1; // Change to return 0 on success
+}
+
+uint64
+sys_filetype(void)
+{
+  char path[MAXPATH];
+  struct inode *ip;
+  int type;
+
+  if(argstr(0, path, MAXPATH) < 0)
+    return -1;
+
+  begin_op();
+  if((ip = namei(path)) == 0){
+    end_op();
+    return -1;
+  }
+
+  ilock(ip);
+  type = ip->type;
+  iunlockput(ip);
+  end_op();
+  return type;
+}
+
+uint64
+sys_inoderefcount(void)
+{
+  char path[MAXPATH];
+  struct inode *ip;
+  int nlink;
+
+  if(argstr(0, path, MAXPATH) < 0)
+    return -1;
+
+  begin_op();
+  if((ip = namei(path)) == 0){
+    end_op();
+    return -1;
+  }
+
+  ilock(ip);
+  nlink = ip->nlink;
+  iunlockput(ip);
+  end_op();
+  return nlink;
+}
+
+uint64
+sys_readlink(void)
+{
+  char path[MAXPATH];
+  int n;
+  uint64 p;
+
+  struct inode *ip;
+  struct symlink sym;
+
+  if(argstr(0, path, MAXPATH) < 0)
+    return -1;
+  argaddr(1, &p);
+  argint(2, &n);
+  if(n <= 0)
+    return -1;
+
+  begin_op();
+  if((ip = namei(path)) == 0){
+    end_op();
+    return -1;
+  }
+
+  ilock(ip);
+  if(ip->type != T_SYMLINK){
+    iunlockput(ip);
+    end_op();
+    return -1;
+  }
+
+  if(readi(ip, 0, (uint64)&sym, 0, sizeof(sym)) != sizeof(sym)){
+    iunlockput(ip);
+    end_op();
+    return -1;
+  }
+
+  iunlockput(ip);
+  end_op();
+
+  if(n > MAXPATH)
+    n = MAXPATH;
+  if(copyout(myproc()->pagetable, p, sym.target, n) < 0)
+    return -1;
+  return n;
+}
