diff --git a/kernel/types.h b/kernel/types.h
index ee73164..6e1bae0 100644
--- a/kernel/types.h
+++ b/kernel/types.h
@@ -8,3 +8,24 @@ typedef unsigned int  uint32;
 typedef unsigned long uint64;
 
 typedef uint64 pde_t;
+
+typedef enum {
+    CMD_NONE, CMD_GETPID, CMD_GETPPID, CMD_UPTIME, CMD_PROC_COUNT,
+} shm_cmd_t;
+
+struct shm_channel {
+    // User → Kernel
+    volatile uint8 u_ready;
+    volatile uint8 u_ack;
+
+    // Kernel → User
+    volatile uint8 k_ready;
+    volatile uint8 k_ack;
+
+    volatile uint64 u_data;
+    volatile uint64 k_data;
+
+    volatile shm_cmd_t cmd;
+    volatile uint64    arg;
+    volatile uint64    result;
+};
diff --git a/user/p3a.c b/user/p3a.c
new file mode 100644
index 0000000..6508619
--- /dev/null
+++ b/user/p3a.c
@@ -0,0 +1,32 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char* argv[])
+{
+    int MAGIC_NUM = 42;
+    if (argc > 1) MAGIC_NUM = atoi(argv[1]);
+
+    struct shm_channel* ch = (struct shm_channel*)kmap();
+    if ((uint64)ch == -1) {
+        printf("kmap failed\n");
+        exit(1);
+    }
+
+    ch->u_ready = 0;
+    ch->u_data = MAGIC_NUM;
+    ch->u_ready = 1;
+
+    while (ch->u_ack == 0);
+
+    ch->u_ack = 0;
+    ch->k_ready = 0;
+
+    printf("Kernel responded: %d\n", (int)ch->k_data);
+    if (ch->k_data != MAGIC_NUM) {
+        printf("Unexpected response from kernel\n");
+        exit(1);
+    }
+
+    exit(0);
+}
