diff --git a/user/file.c b/user/file.c
new file mode 100644
index 0000000..cd2731d
--- /dev/null
+++ b/user/file.c
@@ -0,0 +1,68 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/param.h"
+#include "user/user.h"
+
+static char*
+typestr(int t)
+{
+  switch(t) {
+  case T_DIR:
+    return "dir";
+  case T_FILE:
+    return "file";
+  case T_DEVICE:
+    return "device";
+  case T_SYMLINK:
+    return "symlink";
+  default:
+    return "unknown";
+  }
+}
+
+static void
+show(char* path)
+{
+  int type, inode_rc;
+  char target[MAXPATH];
+  int n;
+
+  type = filetype(path);
+  if(type < 0) {
+    fprintf(2, "file: cannot query %s\n", path);
+    return;
+  }
+
+  inode_rc = inoderefcount(path);
+  if(inode_rc < 0) {
+    fprintf(2, "file: cannot query inode ref count for %s\n", path);
+    return;
+  }
+
+  if(type == T_SYMLINK) {
+    n = readlink(path, target, sizeof(target));
+    if(n < 0) {
+      fprintf(2, "file: cannot readlink %s\n", path);
+      return;
+    }
+    printf("%s: type=%d (%s), inode refcount=%d, target=%s\n", path, type, typestr(type), inode_rc, target);
+  } else {
+    printf("%s: type=%d (%s), inode refcount=%d\n", path, type, typestr(type), inode_rc);
+  }
+}
+
+int
+main(int argc, char* argv[])
+{
+  int i;
+
+  if(argc < 2) {
+    fprintf(2, "Usage: file <file> ...\n");
+    exit(1);
+  }
+
+  for(i = 1; i < argc; i++)
+    show(argv[i]);
+
+  exit(0);
+}
