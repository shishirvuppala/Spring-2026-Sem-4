+
+uint64
+sys_strace_start(void)
+{
+  struct proc* p = myproc();
+  p->strace_buf_syscall = kalloc();
+  p->strace_buf_retval = kalloc();
+  p->strace_size = 0;
+  return 0;
+}
+
+uint64
+sys_strace_end(void)
+{
+  struct proc* p = myproc();
+  if(p->strace_buf_syscall == 0 || p->strace_buf_retval == 0) {
+    return -1;
+  }
+
+  printf("Syscall Trace for PID %d:\n", p->pid);
+  for(int i = 0; i < p->strace_size; i++) {
+    printf("  Syscall %d returned %d\n", p->strace_buf_syscall[i], p->strace_buf_retval[i]);
+  }
+
+  kfree((void*)p->strace_buf_syscall);
+  kfree((void*)p->strace_buf_retval);
+  p->strace_buf_syscall = 0;
+  p->strace_buf_retval = 0;
+  p->strace_size = 0;
+  return 0;
+} 
